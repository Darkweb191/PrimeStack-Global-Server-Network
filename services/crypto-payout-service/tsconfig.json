{
  "compilerOptions": {
    "target":             "ES2022",
    "module":             "NodeNext",
    "moduleResolution":   "NodeNext",
    "outDir":             "./dist",
    "rootDir":            "./src",
    "strict":             true,
    "esModuleInterop":    true,
    "skipLibCheck":       true,
    "noImplicitAny":      true,
    "noUnusedLocals":     true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
