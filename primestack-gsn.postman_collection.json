{
  "info": {
    "_postman_id": "primestack-global-server-network-v1",
    "name": "PrimeStack Global Server Network API",
    "description": "Complete API collection for the PrimeStack Global Server Network platform. Set base_url, hmac_key_id, hmac_secret, and jwt_token variables to get started.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081", "type": "string" },
    { "key": "hmac_key_id", "value": "psk_demo_key_001", "type": "string" },
    { "key": "hmac_secret", "value": "YOUR_HMAC_SECRET_FROM_SEED", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" },
    { "key": "merchant_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api-gateway/info"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('jwt_token', res.data.token);",
                  "  console.log('JWT token set');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@primestack.io\",\n  \"password\": \"Admin@2026\"\n}"
            }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }]
          }
        },
        {
          "name": "KYC Pending",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/kyc/pending",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }]
          }
        }
      ]
    },
