    {
      "name": "S2S Engine",
      "description": "Server-to-Server Payment Engine — receive funds from external servers, manage credentials, and withdraw to bank accounts.",
      "item": [
        {
          "name": "Receipt Templates",
          "item": [
            {
              "name": "Upload Receipt Template (JSON file)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/receipt-templates/upload",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Standard Payment Receipt\",\n  \"description\": \"Receipt for incoming S2S payments\",\n  \"isDefault\": true,\n  \"template\": {\n    \"version\": \"1.0\",\n    \"fields\": [\n      { \"key\": \"ref\",      \"label\": \"Payment Reference\", \"source\": \"reference\",          \"required\": true,  \"format\": \"text\" },\n      { \"key\": \"sender\",   \"label\": \"Sender Reference\",  \"source\": \"senderReference\",   \"required\": false, \"format\": \"text\" },\n      { \"key\": \"amount\",   \"label\": \"Amount\",            \"source\": \"amount\",             \"required\": true,  \"format\": \"currency\" },\n      { \"key\": \"fee\",      \"label\": \"Fee\",               \"source\": \"feeAmount\",          \"required\": false, \"format\": \"currency\" },\n      { \"key\": \"net\",      \"label\": \"Net Amount\",        \"source\": \"netAmount\",          \"required\": true,  \"format\": \"currency\" },\n      { \"key\": \"currency\", \"label\": \"Currency\",          \"source\": \"currency\",           \"required\": true,  \"format\": \"text\" },\n      { \"key\": \"wallet\",   \"label\": \"Destination Wallet\",\"source\": \"receiverWalletAddr\",\"required\": true,  \"format\": \"masked\" },\n      { \"key\": \"date\",     \"label\": \"Processed At\",      \"source\": \"createdAt\",          \"required\": true,  \"format\": \"datetime\" },\n      { \"key\": \"journal\",  \"label\": \"Journal Entry\",     \"source\": \"journalEntryRef\",    \"required\": false, \"format\": \"text\" }\n    ],\n    \"footerNote\": \"This receipt is automatically generated by PrimeStack Global Server Network.\"\n  }\n}"
                }
              }
            },
            {
              "name": "List Receipt Templates",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/receipt-templates"
              }
            },
            {
              "name": "Get Receipt Template",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/receipt-templates/{{s2s_template_id}}"
              }
            },
            {
              "name": "Update Receipt Template",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/receipt-templates/{{s2s_template_id}}",
                "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated receipt template\"\n}" }
              }
            },
            {
              "name": "Delete Receipt Template",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/receipt-templates/{{s2s_template_id}}"
              }
            }
          ]
        },
        {
          "name": "Connections",
          "item": [
            {
              "name": "Create Connection",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.data && res.data.id) {",
                      "  pm.collectionVariables.set('s2s_connection_id', res.data.id);",
                      "  console.log('S2S connection ID set:', res.data.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/connections",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Acme Payment Server\",\n  \"endpointUrl\": \"https://payments.acme.com/api/v1\",\n  \"apiSecret\": \"acme-shared-secret-minimum-16-chars-long\",\n  \"apiKeyHeader\": \"x-api-key\",\n  \"callbackUrl\": \"https://payments.acme.com/webhooks/s2s-receipt\",\n  \"allowedIps\": [\"203.0.113.10\"],\n  \"supportedCurrencies\": [\"USD\", \"EUR\"],\n  \"dailyLimitAmount\": \"50000.00\",\n  \"singleTxLimitAmount\": \"10000.00\",\n  \"metadata\": { \"environment\": \"production\" }\n}"
                }
              }
            },
            {
              "name": "List Connections",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/s2s/connections?status=ACTIVE",
                  "query": [{ "key": "status", "value": "ACTIVE" }]
                }
              }
            },
            {
              "name": "Get Connection",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/connections/{{s2s_connection_id}}"
              }
            },
            {
              "name": "Update Connection",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/connections/{{s2s_connection_id}}",
                "body": { "mode": "raw", "raw": "{\n  \"status\": \"TESTING\",\n  \"dailyLimitAmount\": \"100000.00\"\n}" }
              }
            },
            {
              "name": "Rotate API Secret",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/connections/{{s2s_connection_id}}/rotate-secret",
                "body": { "mode": "raw", "raw": "{\n  \"newSecret\": \"new-secure-secret-min-16-chars-long\"\n}" }
              }
            },
            {
              "name": "Ping Connection",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/connections/{{s2s_connection_id}}/ping"
              }
            }
          ]
        },
        {
          "name": "Payments (Receive Funds)",
          "item": [
            {
              "name": "Receive Payment (from remote server)",
              "description": "Called by the remote partner server to push funds into PrimeStack.\n\nRequired headers:\n- x-s2s-timestamp: Unix ms timestamp\n- x-s2s-nonce: Random UUID or hex string\n- x-s2s-signature: HMAC-SHA256(apiSecret, JSON.stringify({connectionId, amount, currency, timestamp, nonce, senderReference}))\n- x-s2s-idempotency-key: Unique key per payment attempt",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" },
                  { "key": "x-s2s-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-s2s-nonce", "value": "{{$randomUUID}}" },
                  { "key": "x-s2s-signature", "value": "COMPUTE_IN_PRE_REQUEST_SCRIPT" },
                  { "key": "x-s2s-idempotency-key", "value": "{{$randomUUID}}" }
                ],
                "url": "{{base_url}}/s2s/connections/{{s2s_connection_id}}/receive",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"1500.00\",\n  \"currency\": \"USD\",\n  \"feeAmount\": \"15.00\",\n  \"senderReference\": \"ACME-TXN-20261103-001\",\n  \"senderAccountId\": \"acme-user-id-12345\",\n  \"receiverWalletAddr\": \"WALLET-MERCHANT-001-USD\",\n  \"metadata\": {\n    \"orderId\": \"ORD-2026-5511\",\n    \"customerId\": \"CUST-001\"\n  }\n}"
                }
              }
            },
            {
              "name": "List Payments",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/s2s/payments?status=COMPLETED&page=1&pageSize=20",
                  "query": [
                    { "key": "status", "value": "COMPLETED" },
                    { "key": "page", "value": "1" },
                    { "key": "pageSize", "value": "20" }
                  ]
                }
              }
            },
            {
              "name": "Get Payment",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/payments/{{s2s_payment_id}}"
              }
            },
            {
              "name": "Get Payment Receipt",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/payments/{{s2s_payment_id}}/receipt"
              }
            },
            {
              "name": "Reverse Payment",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/payments/{{s2s_payment_id}}/reverse",
                "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Customer requested reversal\"\n}" }
              }
            }
          ]
        },
        {
          "name": "Bank Withdrawals",
          "item": [
            {
              "name": "Create Bank Withdrawal",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.data && res.data.id) {",
                      "  pm.collectionVariables.set('s2s_withdrawal_id', res.data.id);",
                      "  console.log('S2S withdrawal ID set:', res.data.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/withdrawals",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connectionId\": \"{{s2s_connection_id}}\",\n  \"walletAddress\": \"WALLET-MERCHANT-001-USD\",\n  \"amount\": \"5000.00\",\n  \"currency\": \"USD\",\n  \"feeAmount\": \"25.00\",\n  \"bankName\": \"Community Federal Savings Bank\",\n  \"bankCountry\": \"US\",\n  \"accountHolderName\": \"Acme Corp LLC\",\n  \"accountNumber\": \"8335373337\",\n  \"routingNumber\": \"026073008\",\n  \"swiftBic\": \"CFSBUSNY\",\n  \"bankAddress\": \"5 Penn Plaza, 14th Floor, New York, NY 10001\",\n  \"metadata\": { \"purposeCode\": \"SUPP\" }\n}"
                }
              }
            },
            {
              "name": "List Withdrawals",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/s2s/withdrawals?status=SUBMITTED",
                  "query": [{ "key": "status", "value": "SUBMITTED" }]
                }
              }
            },
            {
              "name": "Get Withdrawal",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/withdrawals/{{s2s_withdrawal_id}}"
              }
            },
            {
              "name": "Update Withdrawal Status",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-primestack-key-id", "value": "{{hmac_key_id}}" },
                  { "key": "x-primestack-timestamp", "value": "{{$timestamp}}000" },
                  { "key": "x-primestack-signature", "value": "{{hmac_signature}}" }
                ],
                "url": "{{base_url}}/s2s/withdrawals/{{s2s_withdrawal_id}}/status",
                "body": { "mode": "raw", "raw": "{\n  \"status\": \"COMPLETED\"\n}" }
              }
            }
          ]
        }
      ]
    }
  ]
