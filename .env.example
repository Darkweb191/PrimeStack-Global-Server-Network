# ──────────────────────────────────────────────
# PrimeStack Switch — Environment Configuration
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=debug
APP_NAME=primestack-switch

# PostgreSQL
DATABASE_URL=postgresql://primestack:primestack@localhost:5432/primestack?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (admin auth)
JWT_SECRET=change-me-in-production-use-a-256-bit-key
JWT_EXPIRES_IN=24h

# AES-256-GCM key for encrypted bank account profiles (32 random bytes, base64 encoded).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Store the production value in a secrets manager, never in source control.
BANK_DETAILS_ENCRYPTION_KEY=

# HMAC (API gateway auth)
HMAC_ALGORITHM=sha256
HMAC_HEADER_PREFIX=x-primestack

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# i18n
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,es,ar,pt

# ──────────────────────────────────────────────
# Wise Platform Integration
# Get these from: wise.com/user/account/developer
# ──────────────────────────────────────────────

# API credentials
WISE_API_KEY=
WISE_PROFILE_ID=
WISE_ENV=sandbox

# Wise API base URLs (do not change)
WISE_SANDBOX_URL=https://api.sandbox.transferwise.tech
WISE_LIVE_URL=https://api.transferwise.com

# Webhook secret (set after you register the webhook in Wise dashboard)
WISE_WEBHOOK_SECRET=

# Which platform account to credit when Wise receives funds
WISE_DEFAULT_CREDIT_ACCOUNT=PLATFORM:RESERVE:USD

# Minimum transfer amount to auto-credit (0 = no minimum)
WISE_MIN_AUTO_CREDIT=0
